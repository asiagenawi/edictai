    given-names: Asia
repository-code: "https://github.com/asiagenawi/statescope"
url: "https://edictai.org/"
license: CC-BY-4.0
keywords:
  - artificial intelligence
  - education policy
  - K-12
  - higher education
  - legislation
  - open data
references:
