---
/**
 * Bills & policies: every record in one register, newest first, grouped by
 * year and month. A filter rail on the left where every filter is a dropdown;
 * the jurisdictions chosen are listed under their dropdown and coloured on a
 * small, display-only map. Rows open in place; the detail links to the
 * record's entry on its state page. Everything is rendered at build time; the
 * script only filters, pages, expands, and narrows the CSV download.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { jurisdictions, provisionTypes, records, topics, url } from '../../lib/data';
import { LEVELS, registerRows } from '../../lib/state-page';
import FormDialog from '../../components/FormDialog.astro';
import { PALETTE, usMap } from '../../lib/usmap';
import '../../styles/state.css';
import '../../styles/policies.css';

const all = records();
const byId = new Map(all.map((r) => [r.id, r]));
const juris = new Map(jurisdictions().map((j) => [j.id, j]));
const topicName = new Map(topics().map((t) => [t.code, t.name]));
const ptName = new Map(provisionTypes().map((p) => [p.code, p.name]));
const jName = (id: string) => (id === 'us' ? 'Federal government' : juris.get(id)?.name ?? id);

const rows = registerRows(all).map((row) => {
  const r = byId.get(row.id)!;
  const pv = [...new Set(r.provisions.map((p) => p.type))];
  // The second line: provision types, or the record's topics when it has none.
  const tags = (pv.length ? pv.map((c) => ptName.get(c) ?? c) : r.topics.map((t) => topicName.get(t) ?? t)).slice(0, 3);
  const j = juris.get(r.jurisdiction)!;
  return { ...row, j: r.jurisdiction, abbr: j.abbreviation, jname: j.name, topics: r.topics, pv, tags, href: url(r.path), mkey: row.date && row.date.length >= 7 ? row.date.slice(0, 7) : '' };
});

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
type Item = { mo: string } | { row: (typeof rows)[number] };
const years = [...new Set(rows.map((r) => r.year))];
const groups = years.map((year) => {
  const items: Item[] = [];
  let mon: string | null = null;
  for (const r of rows.filter((x) => x.year === year)) {
    // Records dated only to the year sort after the year's months; they get their own stop rather than sitting under the last month.
    const label = r.mkey ? MONTHS[+r.mkey.slice(5, 7) - 1] : year === 'Undated' ? '' : 'Month not given';
    if (label && label !== mon) { mon = label; items.push({ mo: label }); }
    items.push({ row: r });
  }
  return { year, items };
});

// Filter values, in the order each dropdown lists them.
const uniq = (vs: string[]) => [...new Set(vs)];
const byLabel = (a: [string, string], b: [string, string]) => a[1].localeCompare(b[1]);
const facets: Record<string, [string, string][]> = {
  j: uniq(rows.map((r) => r.j)).map((id) => [id, jName(id)] as [string, string]).sort((a, b) => (a[0] === 'us' ? -1 : b[0] === 'us' ? 1 : byLabel(a, b))),
  t: uniq(rows.map((r) => r.type)).map((v) => [v, v] as [string, string]).sort(byLabel),
  lv: ['k12', 'postsecondary'].filter((l) => rows.some((r) => r.levels.includes(l))).map((l) => [l, LEVELS[l]] as [string, string]),
  st: uniq(rows.map((r) => r.status)).map((v) => [v, v] as [string, string]).sort(byLabel),
  tp: uniq(rows.flatMap((r) => r.topics)).map((c) => [c, topicName.get(c) ?? c] as [string, string]).sort(byLabel),
  pv: uniq(rows.flatMap((r) => r.pv)).map((c) => [c, ptName.get(c) ?? c] as [string, string]).sort(byLabel),
  yr: years.map((y) => [y, y] as [string, string]),
};
const FILTERS = [
  ['t', 'Type', 'All types'],
  ['lv', 'Level', 'All levels'],
  ['st', 'Status', 'All statuses'],
  ['tp', 'Topic', 'All topics'],
  ['pv', 'Provision', 'All provisions'],
  ['yr', 'Year', 'All years'],
] as const;

// The small map: each state's outline, thinned for its size. DC is too small to show; it's in the dropdown.
const map = usMap();
const withRecords = new Set(rows.map((r) => r.j));
const byFips = new Map(jurisdictions().filter((j) => j.fips).map((j) => [j.fips!, j]));
function thin(d: string, tol = 2.4): string {
  return d.split('M').filter(Boolean).map((ring) => {
    const pts = ring.replace(/Z$/, '').split('L').map((p) => p.split(',').map(Number));
    const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
    if (Math.max(...xs) - Math.min(...xs) < 3 && Math.max(...ys) - Math.min(...ys) < 3) return '';
    const out = [pts[0]];
    for (const p of pts.slice(1)) {
      const q = out[out.length - 1];
      if (Math.hypot(p[0] - q[0], p[1] - q[1]) >= tol) out.push(p);
    }
    return out.length < 3 ? '' : 'M' + out.map((p) => `${Math.round(p[0])},${Math.round(p[1])}`).join('L') + 'Z';
  }).join('');
}
const mini = map.states
  .map((s) => ({ s, j: byFips.get(s.fips) }))
  .filter(({ j }) => j && j.id !== 'us-dc')
  .map(({ s, j }) => ({ id: j!.id, d: thin(s.d), colour: PALETTE[s.colour], has: withRecords.has(j!.id) }));

// Provisions tab: one row per jurisdiction, every provision type across; the script marks the cells from the records the filters leave.
const ptypes = provisionTypes();
const mxRows = facets.j.map(([id, name]) => ({ id, name, href: rows.find((r) => r.j === id)!.href.split('#')[0] }));

const csvPath = url('policies/records.csv');
---
<Base title="Bills & policies · Edictai" description="Legislation, executive orders, guidance and policy on artificial intelligence in American schools and colleges." bodyClass="sp pp">
  <link slot="head" rel="alternate" type="application/atom+xml" title="Edictai: Bills & policies" href={url('feed.xml')} />
  <div class="wrap">
    <SiteHeader current="policies" />

    <nav class="crumbs" aria-label="Breadcrumb"><span aria-current="page">Bills &amp; policies</span></nav>
    <div class="ihead">
      <div>
        <h1>Bills &amp; policies</h1>
        <p class="lede">Legislation, executive orders, guidance and policy on artificial intelligence in American schools and colleges, newest first.</p>
      </div>
      <div class="actions">
        <a class="btn" href="#correction" data-open="fix">Report a correction</a>
        <a class="btn primary" id="dl" href={csvPath} download="edictai-records.csv" title="Downloads the records that match your filters">Download CSV</a>
      </div>
    </div>

    <div class="tabs" role="tablist">
      <button role="tab" aria-selected="true" data-p="records">Records</button>
      <button role="tab" aria-selected="false" data-p="provisions">Provisions</button>
    </div>

    <div class="body">
      <nav class="rail" aria-label="Filter records">
        <div class="fg"><h3>Search</h3><input id="f-q" type="search" placeholder="Title, bill number or state" aria-label="Search records" /></div>
        <div class="fg" data-f="j">
          <h3>Jurisdiction</h3>
          <label class="sr" for="f-j">Choose a jurisdiction</label>
          <select id="f-j" class="dd"><option value="">All jurisdictions</option>{facets.j.map(([v, l]) => <option value={v}>{l}</option>)}</select>
          <ul class="jlist"></ul>
          <svg class="mini" id="mini" viewBox={`0 0 ${map.width} ${map.height}`} aria-hidden="true">
            {mini.map((m) => <path d={m.d} data-j={m.id} style={`--c:var(--${m.colour})`} class={m.has ? undefined : 'none'} />)}
          </svg>
        </div>
        {FILTERS.map(([key, title, allLabel]) => (
          <div class="fg" data-f={key}>
            <h3>{title}</h3>
            <label class="sr" for={`f-${key}`}>Choose a {title.toLowerCase()}</label>
            <select id={`f-${key}`} class="dd"><option value="">{allLabel}</option>{facets[key].map(([v, l]) => <option value={v}>{l}</option>)}</select>
            <ul class="jlist"></ul>
          </div>
        ))}
        <button type="button" class="clear" id="clear" hidden>Clear all filters</button>
      </nav>

      <main>
        <section class="panel" id="p-records" role="tabpanel">
        <div id="reg">
          {groups.map((g, gi) => (
            <section class:list={['yg', { first: gi === 0 }]}>
              <div class="yr"><h3>{g.year}</h3></div>
              <div class="grp">
                {g.items.map((it) => 'mo' in it ? (
                  <div class="mo"><span></span><span class="gl"></span><span>{it.mo}</span></div>
                ) : (
                  <Fragment>
                    <div class="reg-row" tabindex="0" role="button" aria-expanded="false" aria-controls={`d-${it.row.id}`}
                      data-id={it.row.id} data-j={it.row.j} data-t={it.row.type} data-lv={it.row.levels.join('|')} data-st={it.row.status}
                      data-tp={it.row.topics.join('|')} data-pv={it.row.pv.join('|')} data-yr={it.row.year}
                      data-q={`${it.row.ident ?? ''} ${it.row.title} ${it.row.jname} ${it.row.abbr} ${it.row.id}`.toLowerCase()}>
                      <span class="dt num">{it.row.day}</span>
                      <span class="gl"><svg viewBox="0 0 12 12" role="img" aria-label={it.row.type} set:html={it.row.glyph} /></span>
                      <span class="ti"><span class="ju">{it.row.abbr}</span>{it.row.ident && it.row.kind !== 'doc' && <span class="mono">{it.row.ident}</span>}<span class="nm">{it.row.title}</span><small><b>{it.row.type}</b>{it.row.tags.length > 0 && ` · ${it.row.tags.join(' · ')}`}</small></span>
                      <span class="st">{it.row.status}</span>
                    </div>
                    <div class="reg-det" id={`d-${it.row.id}`} hidden>
                      <div class="det">
                        <div>
                          <p>{it.row.summary}</p>
                          {it.row.provisions.length > 0 && <Fragment><h4>Provisions</h4><ul class="pvl">{uniq(it.row.provisions.map((p) => p.name)).map((n) => <li>{n}</li>)}</ul></Fragment>}
                        </div>
                        <div class="side">
                          <dl class="kv">
                            <dt>Jurisdiction</dt><dd>{it.row.jname}</dd>
                            <dt>Type</dt><dd>{it.row.type}</dd>
                            <dt>Status</dt><dd>{it.row.status}</dd>
                            {it.row.levels.length > 0 && <Fragment><dt>Level</dt><dd>{it.row.levels.map((l) => LEVELS[l] ?? l).join(', ')}</dd></Fragment>}
                          </dl>
                          <p class="links">
                            {it.row.sources.map((s) => <a href={s.url}>{s.title}</a>)}
                            <a href={it.row.href}>Open on the {it.row.jname} page →</a>
                          </p>
                        </div>
                      </div>
                    </div>
                  </Fragment>
                ))}
              </div>
            </section>
          ))}
        </div>
        <p class="empty" id="r-empty" hidden>No records match these filters.</p>
        <p class="more" id="more-p" hidden><button class="btn" id="more" type="button">Show more</button></p>
        </section>

        <section class="panel" id="p-provisions" role="tabpanel" hidden>
          <div class="mx-tools"><label><input type="checkbox" id="mx-hide" /> Hide provision types with no records</label></div>
          <div class="tbl-wrap"><table class="matrix" id="mx">
            <thead><tr><th scope="col">Jurisdiction</th>{ptypes.map((t) => <th scope="col" class="rec" data-code={t.code}>{t.name}</th>)}</tr></thead>
            <tbody>
              {mxRows.map((m) => (
                <tr data-j={m.id}>
                  <td class="pt"><a href={m.href}>{m.name}</a></td>
                  {ptypes.map((t) => <td class="c" data-code={t.code}></td>)}
                </tr>
              ))}
            </tbody>
          </table></div>
          <p class="empty" id="mx-empty" hidden>No provisions recorded for these filters.</p>
        </section>
      </main>
    </div>
  </div>
  <script id="pp-data" type="application/json" set:html={JSON.stringify(facets)} />
  <FormDialog id="fix" title="Report a correction" subject="Correction" context="Bills & policies" fields={[{ name: 'record', label: 'Record', hint: 'bill number or title', prefill: 'open-records' }, { name: 'change', label: 'What should change', kind: 'textarea', required: true }, { name: 'source', label: 'Source', hint: 'link to the document that shows it', kind: 'url' }]} />
</Base>

<script>
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];
  const FACETS = JSON.parse($('#pp-data').textContent!) as Record<string, [string, string][]>;
  const KEYS = Object.keys(FACETS);
  const ALL: Record<string, string> = { j: 'All jurisdictions', t: 'All types', lv: 'All levels', st: 'All statuses', tp: 'All topics', pv: 'All provisions', yr: 'All years' };
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
  const PAGE = 40;

  const rows = $$('.reg-row');
  const detail = (r: HTMLElement) => document.getElementById(r.getAttribute('aria-controls')!)!;
  const values = (r: HTMLElement, k: string) => (r.dataset[k] ?? '').split('|').filter(Boolean);
  const SEL: Record<string, Set<string>> = Object.fromEntries(KEYS.map((k) => [k, new Set<string>()]));
  const q = $<HTMLInputElement>('#f-q');
  let limit = PAGE;

  function passes(r: HTMLElement, skip?: string) {
    const term = q.value.trim().toLowerCase();
    if (term && !r.dataset.q!.includes(term)) return false;
    return KEYS.every((k) => k === skip || !SEL[k].size || values(r, k).some((v) => SEL[k].has(v)));
  }

  // Every filter is a dropdown: choosing a value adds it to the list under the dropdown, each with Remove.
  // A dropdown offers only values that would still leave records, given the other filters.
  function rail() {
    for (const k of KEYS) {
      const g = $(`.fg[data-f="${k}"]`);
      const live = new Set(rows.filter((r) => passes(r, k)).flatMap((r) => values(r, k)));
      const opts = FACETS[k].filter(([v]) => !SEL[k].has(v) && live.has(v));
      $<HTMLSelectElement>('select', g).innerHTML = `<option value="">${SEL[k].size ? 'Add another…' : ALL[k]}</option>` +
        opts.map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join('');
      $('ul', g).innerHTML = FACETS[k].filter(([v]) => SEL[k].has(v))
        .map(([v, l]) => `<li><span>${esc(l)}</span><button type="button" data-rm="${esc(v)}" aria-label="Remove ${esc(l)}">Remove</button></li>`).join('');
    }
    $('#clear').hidden = !q.value && KEYS.every((k) => !SEL[k].size);
    // The map only shows what's chosen: chosen states take their colour, the rest stay grey.
    const any = SEL.j.size > 0;
    for (const p of $$<SVGPathElement>('#mini path')) {
      p.classList.toggle('on', SEL.j.has(p.dataset.j!));
      p.classList.toggle('dim', any && !SEL.j.has(p.dataset.j!));
    }
  }

  // Tabs
  $$('.tabs button').forEach((b) => b.addEventListener('click', () => {
    $$('.tabs button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    $$('.panel').forEach((p) => (p.hidden = p.id !== 'p-' + b.dataset.p));
  }));

  // Provisions: a dot where any matching record from that jurisdiction has the provision.
  const mxHide = $<HTMLInputElement>('#mx-hide');
  function matrix() {
    const has = new Map<string, Set<string>>();
    for (const r of matched) for (const c of values(r, 'pv')) {
      if (!has.has(r.dataset.j!)) has.set(r.dataset.j!, new Set());
      has.get(r.dataset.j!)!.add(c);
    }
    const used = new Set([...has.values()].flatMap((s) => [...s]));
    for (const tr of $$('#mx tbody tr')) {
      const set = has.get(tr.dataset.j!);
      tr.hidden = !set;
      for (const td of $$('td.c', tr)) td.innerHTML = set?.has(td.dataset.code!) ? '<i class="mdot"></i>' : '';
    }
    for (const el of $$('#mx [data-code]')) {
      el.classList.toggle('off', !used.has(el.dataset.code!));
      el.hidden = mxHide.checked && !used.has(el.dataset.code!);
    }
    $('#mx-empty').hidden = has.size > 0;
    $('#mx').closest<HTMLElement>('.tbl-wrap')!.hidden = has.size === 0;
  }
  mxHide.addEventListener('change', matrix);

  let matched: HTMLElement[] = [];
  function refresh() {
    rail();
    matched = rows.filter((r) => passes(r));
    matrix();
    const shown = new Set(matched.slice(0, limit));
    for (const r of rows) {
      r.hidden = !shown.has(r);
      detail(r).hidden = r.hidden || r.getAttribute('aria-expanded') !== 'true';
    }
    // Year groups and month stops: hide empty ones; mark the ends of each year's line.
    let first = true;
    for (const yg of $$('.yg')) {
      const grp = $('.grp', yg);
      let mo: HTMLElement | null = null, n = 0;
      for (const el of [...grp.children] as HTMLElement[]) {
        if (el.classList.contains('mo')) { if (mo) mo.hidden = n === 0; mo = el; n = 0; }
        else if (el.classList.contains('reg-row') && !el.hidden) n++;
      }
      if (mo) mo.hidden = n === 0;
      const vis = ([...grp.children] as HTMLElement[]).filter((el) => !el.hidden && !el.classList.contains('reg-det'));
      yg.hidden = !vis.some((el) => el.classList.contains('reg-row'));
      yg.classList.toggle('first', first && !yg.hidden);
      if (!yg.hidden) first = false;
      vis.forEach((el, i) => el.classList.toggle('first', i === 0));
      const visRows = vis.filter((el) => el.classList.contains('reg-row'));
      for (const el of visRows) el.classList.toggle('last', el === visRows[visRows.length - 1]);
    }
    $('#r-empty').hidden = matched.length > 0;
    $('#more-p').hidden = matched.length <= limit;
  }

  for (const k of KEYS) {
    const g = $(`.fg[data-f="${k}"]`);
    $<HTMLSelectElement>('select', g).addEventListener('change', (e) => {
      const v = (e.target as HTMLSelectElement).value;
      if (v) { SEL[k].add(v); limit = PAGE; refresh(); }
    });
    $('ul', g).addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-rm]');
      if (b) { SEL[k].delete(b.dataset.rm!); limit = PAGE; refresh(); }
    });
  }
  q.addEventListener('input', () => { limit = PAGE; refresh(); });
  $('#more').addEventListener('click', () => { limit += PAGE; refresh(); });
  $('#clear').addEventListener('click', () => {
    q.value = '';
    KEYS.forEach((k) => SEL[k].clear());
    limit = PAGE;
    refresh();
  });

  // Open a record in place.
  for (const r of rows) {
    const toggle = () => {
      const open = r.getAttribute('aria-expanded') !== 'true';
      r.setAttribute('aria-expanded', String(open));
      detail(r).hidden = !open;
    };
    r.addEventListener('click', toggle);
    r.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
  }

  // Download CSV: the full file, or, with filters on, just the rows that match them.
  function parseCsv(text: string): string[][] {
    const out: string[][] = [];
    let row: string[] = [], f = '', quoted = false;
    for (let i = 0; i < text.length; i++) {
      const ch = text[i];
      if (quoted) {
        if (ch === '"') { if (text[i + 1] === '"') { f += '"'; i++; } else quoted = false; } else f += ch;
      } else if (ch === '"') quoted = true;
      else if (ch === ',') { row.push(f); f = ''; }
      else if (ch === '\n' || ch === '\r') { if (ch === '\r' && text[i + 1] === '\n') i++; row.push(f); out.push(row); row = []; f = ''; }
      else f += ch;
    }
    if (f || row.length) { row.push(f); out.push(row); }
    return out;
  }
  const cell = (v: string) => (/[",\n\r]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v);
  const dl = $<HTMLAnchorElement>('#dl');
  dl.addEventListener('click', async (e) => {
    if (matched.length === rows.length) return;
    e.preventDefault();
    try {
      const [head, ...body] = parseCsv(await (await fetch(dl.href)).text());
      const ids = new Set(matched.map((r) => r.dataset.id));
      const keep = body.filter((r) => ids.has(r[0]));
      const text = [head, ...keep].map((r) => r.map(cell).join(',')).join('\r\n') + '\r\n';
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([text], { type: 'text/csv;charset=utf-8' }));
      a.download = 'edictai-records-filtered.csv';
      document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    } catch { location.href = dl.href; }
  });


  refresh();
</script>
