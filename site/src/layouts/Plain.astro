---
/**
 * Plain layout for record and index pages: wordmark link home, a heading, and
 * the content, set in the shared tokens with no further styling. These pages
 * show the data as built and do not have a visual design of their own.
 */
import Base from './Base.astro';
import { url } from '../lib/data';

interface Props { title: string; heading?: string; description?: string }
const { title, heading = title, description } = Astro.props;
---
<Base title={`${title} · Edictai`} description={description}>
  <header class="top"><a href={url()}>Edictai</a></header>
  <main class="plain">
    <h1>{heading}</h1>
    <slot />
  </main>
</Base>

<style>
.top{padding:24px 0 8px;font-family:var(--serif);font-size:18px;letter-spacing:.1em}
.top a{text-decoration:none}
.plain{max-width:880px;padding-bottom:64px}
.plain :global(h1){font:500 24px/1.2 var(--serif);margin:16px 0}
.plain :global(h2){font:500 16px/1.3 var(--serif);margin:24px 0 8px}
.plain :global(table){border-collapse:collapse;width:100%}
.plain :global(th),.plain :global(td){text-align:left;vertical-align:top;padding:4px 12px 4px 0;border-bottom:1px solid var(--rule)}
.plain :global(th){color:var(--ink-3);font-weight:400}
.plain :global(ul){padding-left:18px}
.plain :global(.muted){color:var(--ink-3)}
</style>
