---
/**
 * Header for the data pages: a ribbon of brand shapes across the top, then the
 * mark and wordmark, the main navigation, and the Ask button (it opens the
 * Ask panel, components/AskPanel.astro, which every page carries). The ribbon
 * flows in from the left on load; a few shapes shake now and then.
 */
import { url } from '../lib/data';

interface Props { current?: 'states' | 'policies' | 'research' | 'articles' }
const { current } = Astro.props;
const NAV = [
  ['states', 'States'],
  ['policies', 'Bills & policies'],
  ['research', 'Research'],
  ['articles', 'Articles'],
] as const;
---
<canvas id="ribbon" aria-hidden="true"></canvas>
<header class="top">
  <a class="brand" href={url()}><svg width="24" height="24" viewBox="0 0 48 48" aria-hidden="true"><defs><clipPath id="hmk"><rect x="2" y="2" width="44" height="44" rx="5"/></clipPath></defs><g clip-path="url(#hmk)"><rect x="2" y="2" width="44" height="44" fill="var(--yellow)"/><rect x="16" y="2" width="14" height="14" fill="var(--blue)"/><path d="M38 2l8 8-8 8-8-8z" fill="var(--green)"/><path d="M2 30a14 14 0 0 1 14-14v14z" fill="var(--sky)"/><circle cx="24" cy="24" r="7" fill="var(--pink)"/><rect x="31" y="17" width="15" height="15" fill="var(--graphite)"/><circle cx="24" cy="39" r="7" fill="var(--blue)"/><rect x="2" y="31" width="15" height="15" fill="var(--mint)"/><rect x="2" y="2" width="15" height="15" fill="var(--mint)"/><g transform="rotate(-45 9.5 9.5)"><path d="M1.5 9.5l3-1.8v3.6z" fill="var(--wood)"/><rect x="4.5" y="7.7" width="9" height="3.6" fill="var(--red)"/><rect x="14.9" y="7.7" width="2.4" height="3.6" rx=".8" fill="var(--pink)"/></g><rect x="31" y="31" width="15" height="15" fill="var(--sky)"/><rect x="33.2" y="33.6" width="10.6" height="7" rx=".6" fill="var(--graphite)"/><rect x="34.2" y="34.6" width="8.6" height="5" fill="var(--blue)"/></g><text font-family="Pinyon Script, Snell Roundhand, cursive" x="24" y="37" text-anchor="middle" font-size="36" fill="#fff">E</text></svg><span class="name"><span class="E">E</span>DICT<span class="ai">AI</span></span><span class="sr">Edictai home</span></a>
  <nav class="main" aria-label="Primary">
    {NAV.map(([key, label]) => <a href={url(`${key}/`)} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
  </nav>
  <button class="ask-btn" type="button" id="ask-open" aria-controls="askp" aria-expanded="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4.5A1.5 1.5 0 0 1 4.5 3h11A1.5 1.5 0 0 1 17 4.5v8a1.5 1.5 0 0 1-1.5 1.5H8l-4 3v-3h.5A1.5 1.5 0 0 1 3 12.5z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>Ask</button>
</header>

<script>
  // The ribbon: rows of small brand shapes in the palette, flowing in left to right.
  const cv = document.getElementById('ribbon') as HTMLCanvasElement;
  const c = cv.getContext('2d')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const css = (n: string) => getComputedStyle(document.documentElement).getPropertyValue('--' + n).trim();
  const PAL = ['red', 'yellow', 'blue', 'sky', 'green', 'mint', 'pink', 'graphite', 'butter'];
  const H = 36;
  function rng(s: number) {
    let x = s >>> 0 || 1;
    return () => ((x = Math.imul(x ^ (x >>> 15), 2246822507)), (x = Math.imul(x ^ (x >>> 13), 3266489909)), ((x ^= x >>> 16) >>> 0) / 4294967296);
  }
  function shape(k: number, s: number, col: string) {
    c.fillStyle = col;
    c.beginPath();
    const h = s / 2, r = s * 0.47;
    if (k === 0) c.arc(h, h, r, 0, 7);
    else if (k === 1) { c.moveTo(h, h - r); c.arc(h, h, r, -Math.PI / 2, Math.PI / 2); }
    else if (k === 2) { c.moveTo(0, s); c.arc(0, s, s * 0.96, -Math.PI / 2, 0); }
    else if (k === 3) c.rect(1, 1, s - 2, s - 2);
    else if (k === 4) { c.moveTo(h, 0); c.lineTo(s, h); c.lineTo(h, s); c.lineTo(0, h); }
    else { c.moveTo(h, 1); c.lineTo(s - 1, s - 1); c.lineTo(1, s - 1); }
    c.fill();
  }
  type Item = { x: number; y: number; k: number; col: string; dl: number; sh: boolean; ph: number };
  let items: Item[] = [];
  let t0 = 0;
  function lay() {
    const d = Math.min(2, devicePixelRatio || 1), W = cv.clientWidth;
    cv.width = W * d; cv.height = H * d; c.setTransform(d, 0, 0, d, 0, 0);
    const r = rng(11);
    items = [];
    for (let y = 2; y < H - 12; y += 17) for (let x = 0; x < W; x += 17) {
      if (r() > 0.82) continue;
      items.push({ x, y, k: Math.floor(r() * 6), col: css(PAL[Math.floor(r() * PAL.length)]), dl: (x / W) * 900 + r() * 200, sh: r() < 0.07, ph: r() * 9 });
    }
  }
  function frame(now: number) {
    c.clearRect(0, 0, cv.clientWidth, H);
    for (const it of items) {
      const t = still ? 1 : Math.min(1, Math.max(0, (now - t0 - it.dl) / 500));
      if (!t) continue;
      c.save();
      c.globalAlpha = t;
      c.translate(it.x + 7.5, it.y + 7.5);
      if (it.sh && !still) c.rotate(Math.sin(now / 180 + it.ph) * 0.25 * Math.max(0, Math.sin(now / 1400 + it.ph)));
      c.scale(0.4 + 0.6 * t, 0.4 + 0.6 * t);
      c.translate(-7.5, -7.5);
      shape(it.k, 15, it.col);
      c.restore();
    }
    if (!still) requestAnimationFrame(frame);
  }
  lay();
  t0 = performance.now();
  requestAnimationFrame(frame);
  addEventListener('resize', lay);
</script>
