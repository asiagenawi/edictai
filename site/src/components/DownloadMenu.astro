---
/**
 * A Download button that opens a short menu of formats: JSON, CSV and Excel.
 * Each item links to the static file at `{base}.{ext}`. A page that filters its list
 * sets `filter` on the element (see below) and the menu saves just the matching rows.
 */
import { FORMATS } from '../lib/dataset';

interface Props {
  /** Path of the files without the extension, e.g. url('policies/records'). */
  base: string;
  /** Saved file name without the extension. */
  file: string;
  label?: string;
  /** `button` for the title-bar buttons, `link` for an inline text link. */
  look?: 'button' | 'link';
  title?: string;
  /** The dataset's list separators, so a filtered CSV joins lists the same way. */
  seps?: Record<string, string>;
}
const { base, file, label = 'Download', look = 'button', title, seps } = Astro.props;
---
<div class:list={['dlm', look]} data-base={base} data-file={file} data-seps={seps ? JSON.stringify(seps) : undefined}>
  <button type="button" class:list={look === 'button' ? 'btn primary' : 'dlm-link'} aria-haspopup="menu" aria-expanded="false" title={title}>
    {label}<svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="dlm-menu" role="menu" hidden>
    {FORMATS.map((f) => <a role="menuitem" href={`${base}.${f.ext}`} download={`${file}.${f.ext}`} data-ext={f.ext}>{f.label}</a>)}
  </div>
</div>

<style is:global>
.dlm{position:relative}
.dlm .btn{width:100%;justify-content:center;gap:8px}
.dlm svg{width:10px;height:6px;flex:none}
.dlm-link{display:inline-flex;align-items:center;gap:6px;padding:0;border:0;background:none;font:inherit;color:inherit;cursor:pointer}
.dlm-menu{position:absolute;top:calc(100% + 4px);right:0;z-index:30;min-width:100%;padding:4px 0;background:var(--paper);border:1px solid #cfd0cc;border-radius:3px;box-shadow:0 10px 24px -12px rgba(32,30,31,.28)}
.dlm.link .dlm-menu{right:auto;left:0;min-width:120px}
.dlm .dlm-menu a[role]{display:block;border:0!important;padding:7px 14px;font:400 13px/1.3 var(--sans,"DM Sans","Helvetica Neue",Arial,sans-serif);color:var(--ink);text-decoration:none;white-space:nowrap}
.dlm .dlm-menu a[role]:hover,.dlm .dlm-menu a[role]:focus-visible{background:#f3f1ee;outline:none}
</style>

<script>
  import { render, FORMATS, type Dataset, type Ext, type Row } from '../lib/dataset';

  /** Set by a page that filters: returns the ids to keep, or null when nothing is filtered. */
  type Filtered = HTMLElement & { filter?: () => Set<string> | null };

  for (const el of document.querySelectorAll<Filtered>('.dlm')) {
    const btn = el.querySelector('button')!;
    const menu = el.querySelector<HTMLElement>('.dlm-menu')!;
    const items = [...menu.querySelectorAll<HTMLAnchorElement>('a')];
    const open = (v: boolean, focus = false) => {
      menu.hidden = !v;
      btn.setAttribute('aria-expanded', String(v));
      if (v && focus) items[0].focus();
    };
    btn.addEventListener('click', () => open(menu.hidden));
    btn.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); open(true, true); } });
    menu.addEventListener('keydown', (e) => {
      const i = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      if (e.key === 'Escape') { open(false); btn.focus(); }
    });
    document.addEventListener('click', (e) => { if (!el.contains(e.target as Node)) open(false); });

    for (const a of items) {
      a.addEventListener('click', async (e) => {
        open(false);
        const keep = el.filter?.();
        if (!keep) return;
        // Filters are on: build the file from the full JSON, keeping only the matching rows.
        e.preventDefault();
        const ext = a.dataset.ext as Ext;
        try {
          const full = await (await fetch(`${el.dataset.base}.json`)).json() as { title: string; records: Row[] } & Record<string, unknown>;
          const { title, license: _l, records, ...meta } = full;
          const rows = records.filter((r) => keep.has(String(r.id)));
          const columns = Object.keys(records[0] ?? {});
          const d: Dataset = { title: `${title} (filtered)`, columns, rows, meta: meta as Record<string, string>, seps: JSON.parse(el.dataset.seps || '{}') };
          const link = document.createElement('a');
          link.href = URL.createObjectURL(new Blob([render(d, ext)], { type: FORMATS.find((f) => f.ext === ext)!.type }));
          link.download = `${el.dataset.file}-filtered.${ext}`;
          document.body.append(link); link.click(); link.remove();
          setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        } catch { location.href = a.href; }
      });
    }
  }
</script>
